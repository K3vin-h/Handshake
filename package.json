{
  "name": "handshake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "web": "vite",
    "api": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:smoke": "node server/db.smoke.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.mjs\""
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tensorflow/tfjs": "^4.22.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
