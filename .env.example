# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Model for the coach and practice-word endpoints; change if AI Studio shows a different free-tier model.
GEMINI_MODEL=gemini-3.6-flash
PORT=8787
# Keep disabled until the documented H4 human snapshot gate passes.
SNAPSHOT_ENABLED=0
# Optional development-only cache export for reviewed demo responses.
CACHE_EXPORT_ENABLED=0

# Optional Tiger Data integration. Unset = no-op attempt writes and empty stats.
# Use the Tiger Cloud PostgreSQL connection string, including sslmode=require.
DATABASE_URL=
# Set to 1 only behind a single trusted local proxy; binds API to 127.0.0.1.
SERVE_STATIC=0

# Optional accounts (need DATABASE_URL). Google client ID is public; Resend key is a server-only secret, never a VITE_ variable.
# Google OAuth web client ID for "Sign in with Google" (public).
GOOGLE_CLIENT_ID=
# Resend API key for password-reset emails (server-only secret).
RESEND_API_KEY=
# Verified sender address for reset emails, e.g. "Handshake <no-reply@yourdomain>".
RESEND_FROM=
# Origin of the web app, used only to build password-reset links (reset is off without it).
APP_ORIGIN=http://localhost:5173

# Optional n8n: all three required. Server-only secrets, never VITE_ variables.
N8N_SUBSCRIBE_URL=
N8N_EVENT_URL=
N8N_SECRET=
# Optional Maritime: both required; unavailable/invalid responses fall back locally.
MARITIME_AGENT_URL=
MARITIME_AGENT_TOKEN=
